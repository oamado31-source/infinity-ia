{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DEC-097 Candidate Composition Fixture Only — synthetic, no engine integration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fixture_only",
    "source_kind",
    "context",
    "policies",
    "effects"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0-candidate"
    },
    "fixture_only": {
      "const": true
    },
    "source_kind": {
      "const": "SYNTHETIC_TEST"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_only",
        "campaign_id",
        "branch_id",
        "epoch",
        "pack_hash",
        "scope_id",
        "world_day",
        "confirmed_parent_ids"
      ],
      "properties": {
        "fixture_only": {
          "const": true
        },
        "campaign_id": {
          "type": "string",
          "minLength": 1
        },
        "branch_id": {
          "type": "string",
          "minLength": 1
        },
        "epoch": {
          "type": "integer",
          "minimum": 1
        },
        "pack_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "scope_id": {
          "type": "string",
          "minLength": 1
        },
        "world_day": {
          "type": "integer",
          "minimum": 0
        },
        "confirmed_parent_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "policies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/policy"
      }
    },
    "effects": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/effect"
      }
    }
  },
  "$defs": {
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric_id",
        "domain",
        "unit",
        "operator",
        "baseline",
        "min",
        "max",
        "policy_revision",
        "rounding"
      ],
      "properties": {
        "metric_id": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "enum": [
            "COIN",
            "INTENSITY",
            "RISK_POINTS"
          ]
        },
        "operator": {
          "enum": [
            "BASELINE_PLUS_BPS",
            "ADD_ABSOLUTE"
          ]
        },
        "baseline": {
          "type": "integer"
        },
        "min": {
          "type": "integer"
        },
        "max": {
          "type": "integer"
        },
        "policy_revision": {
          "type": "integer",
          "minimum": 1
        },
        "rounding": {
          "const": "HALF_EVEN"
        }
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effect_id",
        "event_id",
        "rule_id",
        "lineage_root_id",
        "metric_id",
        "stack_family",
        "priority",
        "delta",
        "campaign_id",
        "branch_id",
        "epoch",
        "pack_hash",
        "scope_id",
        "world_day_start",
        "hold_days",
        "fade_days",
        "status",
        "risk",
        "authorized",
        "host_receipt_id",
        "source_kind"
      ],
      "properties": {
        "effect_id": {
          "type": "string",
          "minLength": 1
        },
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "rule_id": {
          "type": "string",
          "minLength": 1
        },
        "lineage_root_id": {
          "type": "string",
          "minLength": 1
        },
        "metric_id": {
          "type": "string",
          "minLength": 1
        },
        "stack_family": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "delta": {
          "type": "integer",
          "minimum": -1000000,
          "maximum": 1000000
        },
        "campaign_id": {
          "type": "string",
          "minLength": 1
        },
        "branch_id": {
          "type": "string",
          "minLength": 1
        },
        "epoch": {
          "type": "integer",
          "minimum": 1
        },
        "pack_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "scope_id": {
          "type": "string",
          "minLength": 1
        },
        "world_day_start": {
          "type": "integer",
          "minimum": 0
        },
        "hold_days": {
          "type": "integer",
          "minimum": 0
        },
        "fade_days": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "enum": [
            "PROPOSED",
            "DISPATCHED",
            "UNCERTAIN",
            "CONFIRMED",
            "REJECTED"
          ]
        },
        "risk": {
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH"
          ]
        },
        "authorized": {
          "type": "boolean"
        },
        "host_receipt_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_kind": {
          "const": "SYNTHETIC_TEST"
        },
        "requires_parent_effect_id": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
