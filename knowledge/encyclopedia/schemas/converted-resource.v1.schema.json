{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://infinity-ai.local/schemas/encyclopedia/converted-resource.v1.schema.json",
  "title": "Infinity AI — converted resource (SPEC-012 module, CR-2026-032)",
  "description": "One creature brought from another game into BG2:EE. Entries live only in the local inventory (~/.infinity-ai/resources/install-<build>/resources.json); the repository keeps this schema. No game files, numbers or texts go in here: only references (resrefs, sheet paths, source ids) and states.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "resource_id",
    "source_game",
    "source_creature_id",
    "converted_cre_id",
    "animation_ref",
    "animation_assets",
    "original_stats_ref",
    "converted_stats_ref",
    "conversion_source",
    "target_engine",
    "rights_status",
    "validation_status",
    "recorded_at"
  ],
  "properties": {
    "schema": {
      "const": "infinity-ai.converted-resource.v1"
    },
    "resource_id": {
      "type": "string",
      "pattern": "^converted:[a-z0-9][a-z0-9-]{0,63}$"
    },
    "creature_ref": {
      "type": "string",
      "pattern": "^creature:[a-z0-9][a-z0-9-]{0,63}$",
      "description": "The curated encyclopedia record, when there is one."
    },
    "source_game": {
      "enum": [
        "BG1",
        "SOD",
        "BG2",
        "TOB",
        "IWD",
        "IWD_HOW",
        "IWD_TOTL",
        "IWD2",
        "NWN",
        "ADND2",
        "OTHER"
      ]
    },
    "source_creature_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "The creature's identifier in the source (resref, page id)."
    },
    "converted_cre_id": {
      "type": "string",
      "pattern": "^IA[A-Z0-9]{1,6}$"
    },
    "script_name": {
      "type": "string",
      "pattern": "^INFAI_[A-Z0-9_]{1,26}$"
    },
    "animation_ref": {
      "type": "string",
      "pattern": "^0x[0-9A-F]{4} [A-Z0-9_-]{1,40}$",
      "description": "ANIMATE.IDS code and symbol, e.g. '0xE251 GIANT_VERBEEG'."
    },
    "animation_assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "sound_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "script_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "original_stats_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "The local source sheet (path under ~/.infinity-ai/sheets/)."
    },
    "converted_stats_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "The local creature registry entry (templates.json)."
    },
    "conversion_source": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
      "description": "A source_id of sources.json (CONVERSION_PROJECT, COMMUNITY_DB...)."
    },
    "conversion_note": {
      "type": "string",
      "maxLength": 400
    },
    "target_engine": {
      "enum": [
        "BG2EE",
        "EET",
        "BGEE",
        "IWDEE"
      ]
    },
    "rights_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "license",
        "use"
      ],
      "properties": {
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "use": {
          "enum": [
            "LAB_ONLY",
            "OPEN"
          ]
        },
        "approved_by": {
          "type": "string",
          "maxLength": 40
        },
        "approved_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      }
    },
    "validation_status": {
      "enum": [
        "DECLARED",
        "ASSETS_PRESENT",
        "DRAWN_IN_GAME",
        "APPROVED"
      ]
    },
    "evidence_ref": {
      "type": "string",
      "maxLength": 200
    },
    "recorded_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resref",
        "type",
        "present"
      ],
      "properties": {
        "resref": {
          "type": "string",
          "pattern": "^[A-Z0-9_#-]{1,8}$"
        },
        "type": {
          "enum": [
            "INI",
            "BAM",
            "WAV",
            "BCS",
            "ITM",
            "SPL",
            "DLG",
            "2DA"
          ]
        },
        "present": {
          "type": "boolean",
          "description": "In the build or in the lab override."
        },
        "from": {
          "type": "string",
          "maxLength": 120,
          "description": "Where it came from: 'build', or the project's file it was copied from."
        }
      }
    }
  }
}
