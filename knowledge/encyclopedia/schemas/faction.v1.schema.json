{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://infinity-ai.local/schemas/encyclopedia/faction.v1.schema.json",
  "title": "Infinity AI encyclopedia — FACTION (SPEC-012, CR-2026-030)",
  "description": "Curated record kept in the repository. Extracted game attributes (stats, levels, item and spell properties, positions, game texts) are not allowed here: they live in the local catalog.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "canonical_id",
    "category",
    "display_name",
    "source_records",
    "verification_status",
    "source_refs"
  ],
  "properties": {
    "schema": {
      "const": "infinity-ai.encyclopedia.faction.v1"
    },
    "canonical_id": {
      "type": "string",
      "pattern": "^faction:[a-z0-9][a-z0-9-]{0,63}$"
    },
    "category": {
      "const": "FACTION"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "alternate_names": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "uniqueItems": true
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 280,
      "description": "Own words (CR-2026-030); never text copied from a game or book."
    },
    "source_records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source_record"
      }
    },
    "verification_status": {
      "enum": [
        "DISCOVERED",
        "EXTRACTED",
        "CROSS_REFERENCED",
        "SOURCE_VERIFIED",
        "CURATED",
        "APPROVED",
        "DISPUTED",
        "RESTRICTED"
      ]
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationship"
      }
    },
    "refs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "curation": {
          "type": "string",
          "pattern": "^knowledge/npcs/[a-z0-9_-]+\\.[a-z]{2}_[A-Z]{2}\\.json$"
        },
        "canon": {
          "type": "string",
          "maxLength": 80
        },
        "persona": {
          "type": "string",
          "maxLength": 80
        }
      }
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
      }
    },
    "curation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "checked_by",
        "checked_at"
      ],
      "properties": {
        "status": {
          "enum": [
            "CHECKED",
            "DRAFT"
          ]
        },
        "checked_by": {
          "type": "string",
          "minLength": 1
        },
        "checked_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "note": {
          "type": "string",
          "maxLength": 300
        }
      }
    },
    "organization_type": {
      "type": "string",
      "maxLength": 40
    },
    "region_refs": {
      "$ref": "#/$defs/id_refs"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verification_status": {
            "enum": [
              "CURATED",
              "APPROVED"
            ]
          }
        }
      },
      "then": {
        "required": [
          "curation",
          "summary"
        ]
      }
    }
  ],
  "$defs": {
    "source_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "game"
      ],
      "properties": {
        "game": {
          "enum": [
            "BG1",
            "SOD",
            "BG2",
            "IWD1",
            "IWD2",
            "NWN"
          ]
        },
        "expansion": {
          "type": "string",
          "maxLength": 20
        },
        "resref": {
          "type": "string",
          "pattern": "^[A-Z0-9_#-]{1,8}$"
        },
        "blueprint": {
          "type": "string",
          "maxLength": 32
        },
        "source_version": {
          "type": "string",
          "maxLength": 40
        },
        "verification_status": {
          "enum": [
            "DISCOVERED",
            "EXTRACTED",
            "CROSS_REFERENCED",
            "SOURCE_VERIFIED",
            "CURATED",
            "APPROVED",
            "DISPUTED",
            "RESTRICTED"
          ]
        }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "target"
      ],
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^[A-Z][A-Z_]{1,39}$"
        },
        "target": {
          "type": "string",
          "pattern": "^(pending:)?[a-z]+:[a-z0-9][a-z0-9-]{0,63}$"
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "area_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z0-9]{1,8}$"
      }
    },
    "id_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 80
      }
    },
    "rule_family": {
      "enum": [
        "ADND2E_IE",
        "DND3E_IE",
        "DND3E_NWN",
        "OTHER"
      ]
    }
  }
}
