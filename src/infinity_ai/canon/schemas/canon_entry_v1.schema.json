{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "infinity-ai.canon-entry.v1",
  "title": "SPEC-005 curated canon entry (one per file, partitioned by DR year)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "kind",
    "partition_year_dr",
    "title",
    "summary",
    "valid_from_dr",
    "valid_to_dr",
    "date_precision",
    "region_id",
    "area_resrefs",
    "source_refs",
    "verification_status",
    "access_scope",
    "curation"
  ],
  "properties": {
    "schema": {
      "const": "infinity-ai.canon-entry.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^(region|event|org|char|place|rel):[a-z0-9-]{1,64}$"
    },
    "kind": {
      "enum": [
        "REGION",
        "EVENT",
        "ORGANIZATION",
        "CHARACTER",
        "PLACE",
        "RELATIONSHIP"
      ]
    },
    "partition_year_dr": {
      "type": "integer"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "summary": {
      "type": "string",
      "maxLength": 280
    },
    "valid_from_dr": {
      "type": [
        "integer",
        "null"
      ]
    },
    "valid_to_dr": {
      "type": [
        "integer",
        "null"
      ]
    },
    "date_precision": {
      "enum": [
        "EXACT_DAY",
        "MONTH_ONLY",
        "YEAR_ONLY",
        "RANGE",
        "APPROX",
        "UNKNOWN"
      ]
    },
    "region_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^region:[a-z0-9-]{1,64}$"
    },
    "area_resrefs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z0-9_#-]{1,8}$"
      },
      "uniqueItems": true
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "locator"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,64}$"
          },
          "locator": {
            "type": "string",
            "maxLength": 120
          }
        }
      }
    },
    "verification_status": {
      "enum": [
        "RESEARCH_ONLY",
        "CROSS_REFERENCED",
        "SOURCE_CHECKED",
        "DISPUTED",
        "CAMPAIGN_CANON"
      ]
    },
    "access_scope": {
      "enum": [
        "CANON_REFERENCE",
        "COMMON_REGIONAL",
        "RESTRICTED"
      ]
    },
    "curation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "curated_by",
        "curated_at",
        "checked_by",
        "checked_at"
      ],
      "properties": {
        "curated_by": {
          "type": "string"
        },
        "curated_at": {
          "type": "string"
        },
        "checked_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "checked_at": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "knowledge_layers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "POPULAR"
      ],
      "description": "ADR-0117: the summary's facts by difficulty, restated in our words; no new facts.",
      "properties": {
        "POPULAR": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "INFORMED": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "STUDIED": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "subject_id": {
      "type": "string",
      "pattern": "^(npc|region|event|org|char|place):[a-z0-9-]{1,64}$"
    },
    "predicate": {
      "type": "string",
      "enum": [
        "OWNER_OF",
        "WORKS_AT",
        "MANAGES_FOR",
        "EMPLOYED_BY",
        "FREQUENTS",
        "MEMBER_OF",
        "ALLIED_WITH",
        "HOSTILE_TO",
        "FAMILY_OF",
        "MENTORS",
        "APPRENTICE_OF",
        "REPORTS_TO",
        "SERVES"
      ]
    },
    "object_id": {
      "type": "string",
      "pattern": "^(npc|region|event|org|char|place):[a-z0-9-]{1,64}$"
    },
    "context_id": {
      "type": "string",
      "pattern": "^(npc|region|event|org|char|place):[a-z0-9-]{1,64}$"
    },
    "audience": {
      "type": "string",
      "enum": [
        "REGIONAL_PUBLIC",
        "AFFILIATED",
        "EXPLICIT_NPCS"
      ]
    },
    "eligible_affiliations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^place:[a-z0-9-]{1,64}:[A-Z][A-Z0-9_]{0,31}$"
      }
    },
    "allowed_npc_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^npc:[a-z0-9-]{1,64}$"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "RELATIONSHIP"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "subject_id",
          "predicate",
          "object_id",
          "audience"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "RELATIONSHIP"
          },
          "access_scope": {
            "const": "COMMON_REGIONAL"
          }
        },
        "required": [
          "kind",
          "access_scope"
        ]
      },
      "then": {
        "properties": {
          "audience": {
            "const": "REGIONAL_PUBLIC"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "RELATIONSHIP"
          },
          "access_scope": {
            "const": "RESTRICTED"
          },
          "audience": {
            "const": "AFFILIATED"
          }
        },
        "required": [
          "kind",
          "access_scope",
          "audience"
        ]
      },
      "then": {
        "required": [
          "eligible_affiliations"
        ],
        "properties": {
          "eligible_affiliations": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "RELATIONSHIP"
          },
          "access_scope": {
            "const": "RESTRICTED"
          },
          "audience": {
            "const": "EXPLICIT_NPCS"
          }
        },
        "required": [
          "kind",
          "access_scope",
          "audience"
        ]
      },
      "then": {
        "required": [
          "allowed_npc_ids"
        ],
        "properties": {
          "allowed_npc_ids": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
